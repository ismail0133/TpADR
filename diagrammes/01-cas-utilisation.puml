@startuml
title ProxiVroum - Diagramme de cas d'utilisation

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  ArrowColor #333333
}

actor "Conducteur" as Conducteur
actor "Passager" as Passager
actor "Modérateur" as Moderateur
actor "Service Comptabilité" as Comptabilite
actor "Service de paiement" as Paiement

rectangle "Plateforme ProxiVroum" {

  usecase "Publier un trajet" as UC_Publier
  usecase "Rechercher un trajet" as UC_Rechercher
  usecase "Réserver un trajet" as UC_Reserver
  usecase "Effectuer le paiement" as UC_Payer
  usecase "Noter après trajet" as UC_Noter
  usecase "Signaler un litige" as UC_Signaler
  usecase "Traiter un litige" as UC_Traiter
  usecase "Consulter les statistiques" as UC_Stats
  usecase "Exporter les données comptables" as UC_Export
}

Conducteur --> UC_Publier
Conducteur --> UC_Noter
Conducteur --> UC_Signaler

Passager --> UC_Rechercher
Passager --> UC_Reserver
Passager --> UC_Noter
Passager --> UC_Signaler

UC_Reserver --> UC_Payer : <<include>>

Moderateur --> UC_Traiter
Moderateur --> UC_Stats

Comptabilite --> UC_Export
Comptabilite --> UC_Stats

Paiement --> UC_Payer

@enduml
